              "pm.test(\"Unknown category is rejected, not silently scored\", () =>\r\n  pm.response.to.have.status(422));\r\n\r\npm.test(\"Error names the offending field\", () => {\r\n  const detail = JSON.stringify(pm.response.json().detail);\r\n  pm.expect(detail).to.include(\"smoking_status\");\r\n  pm.expect(detail).to.include(\"literal_error\");\r\n});"
            ]
          }
        }
