      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Responds in under 2s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ping"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Predict - valid customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test(\"Premium is a positive integer in INR\", () => {\r\n  pm.expect(body.predicted_premium).to.be.a(\"number\").and.to.be.above(0);\r\n  pm.expect(body.currency).to.eql(\"INR\");\r\n});\r\n\r\npm.environment.set(\"baseline_premium\", body.predicted_premium);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"age\": 35,\r\n  \"number_of_dependants\": 2,\r\n  \"income_lakhs\": 12,\r\n  \"genetical_risk\": 2,\r\n  \"insurance_plan\": \"Gold\",\r\n  \"employment_status\": \"Salaried\",\r\n  \"gender\": \"Male\",\r\n  \"marital_status\": \"Married\",\r\n  \"bmi_category\": \"Normal\",\r\n  \"smoking_status\": \"No Smoking\",\r\n  \"region\": \"Northwest\",\r\n  \"medical_history\": \"No Disease\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/predict_premium",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "predict_premium"
          ]
        }
      },
      "response": []
    },
    {
