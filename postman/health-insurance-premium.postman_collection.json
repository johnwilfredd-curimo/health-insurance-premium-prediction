        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"A regular smoker is quoted more than a non-smoker\", () => {\r\n  const baseline = Number(pm.environment.get(\"baseline_premium\"));\r\n  pm.expect(pm.response.json().predicted_premium).to.be.above(baseline);\r\n});"
            ]
          }
        }
      ],
